{
  "manifest_version": 3,
  "name": "Canvas Planner",
  "version": "1.4.0",
  "description": "Plans self-assigned target dates for your Canvas assignments, so work gets done early.",
  "homepage_url": "https://github.com/mgabbitas/canvasplanner",
  "browser_specific_settings": {
    "gecko": {
      "id": "canvasplanner@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.instructure.com/*"
  ],
  "chrome_url_overrides": {
    "newtab": "src/ui/planner.html"
  },
  "options_ui": {
    "page": "src/ui/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Canvas Planner: today",
    "default_icon": {
      "16": "icons/logo-16.png",
      "32": "icons/logo-32.png",
      "48": "icons/logo-48.png",
      "96": "icons/logo-96.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "scripts": [
      "src/background.js"
    ],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.instructure.com/*"
      ],
      "js": [
        "src/browser.js",
        "src/content/canvas-visit.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icons/logo-48.png",
    "96": "icons/logo-96.png",
    "128": "icons/logo-128.png"
  }
}
