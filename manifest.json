{
  "manifest_version": 3,
  "name": "Canvas Planner",
  "version": "1.1.0",
  "description": "Plans self-assigned target dates for Canvas assignments.",
  "browser_specific_settings": {
    "gecko": {
      "id": "canvasplanner@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://byui.instructure.com/*"
  ],
  "chrome_url_overrides": {
    "newtab": "src/ui/planner.html"
  },
  "options_ui": {
    "page": "src/ui/options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": [
      "src/background.js"
    ],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://byui.instructure.com/*"
      ],
      "js": [
        "src/content/canvas-visit.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icons/logo.svg",
    "96": "icons/logo.svg"
  }
}
